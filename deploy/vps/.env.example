# ===== Beeznoo na VPS — copiar para .env e preencher (o .env nunca vai para o git) =====
# Gerar os segredos: ./generate-secrets.sh >> .env  (e apagar aqui as linhas repetidas)

# ---- Domínios (registos DNS A a apontar para o IP da VPS) ----
WEB_DOMAIN=beeznoo.ao
S3_DOMAIN=s3.beeznoo.ao
# o mesmo que S3_DOMAIN, só o nome (sem https:// nem porta)
S3_DOMAIN_HOST=s3.beeznoo.ao
PUBLIC_WEB_URL=https://beeznoo.ao
PUBLIC_S3_URL=https://s3.beeznoo.ao
# email para os avisos do Let's Encrypt
ACME_EMAIL=tech@beeznoo.ao

# ---- Base de dados (Postgres no próprio servidor) ----
DB_NAME=beeznoo
DB_USER=beeznoo
DB_PASSWORD=
DB_POOL_SIZE=10

# ---- Armazenamento (Garage) ----
S3_BUCKET=beeznoo
# GK + 24 hexadecimais / 64 hexadecimais (generate-secrets.sh)
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
# espaço reservado para ficheiros
GARAGE_CAPACITY=50G

# ---- Segurança ----
# ≥ 32 bytes; a API não arranca sem ele
JWT_SECRET=
ADMIN_MFA_ENABLED=true
RATE_LIMITS_ENABLED=true
RATE_LIMIT_STORE=memory

# ---- Login Google (Google Cloud › Credenciais › URI de redirecionamento: https://beeznoo.ao/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Códigos OTP por WhatsApp (Losambo) ----
WHATSAPP_API_URL=https://message.beeznoo.ao/v1
WHATSAPP_API_KEY_PRD=
WHATSAPP_API_KEY_TST=
WHATSAPP_ENV=prd
OTP_CHANNEL=auto
# SMS (opcional, alternativa)
OMBALA_TOKEN=
OMBALA_SENDER=Beeznoo

# ---- Email (Resend, opcional) ----
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM="Beeznoo <noreply@beeznoo.ao>"

# ---- Produto ----
KYC_REQUIRED=true
PAYMENTS_MODE=direct
# Taxa de serviço sobre o aluguer (0.08 = 8%). O frontend lê-a da API (GET /api/v1/config)
PAYMENTS_SERVICE_FEE_RATE=0.08
COMPANY_LEGAL_NAME=Beeznoo
COMPANY_NIF=
COMPANY_ADDRESS="Luanda, Angola"
COMPANY_EMAIL=ajuda@beeznoo.ao
NEXT_PUBLIC_WHATSAPP_NUMBER=244939351150

# ---- JVM (opcional; omissão: 50% da RAM do contentor) ----
# API_JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
