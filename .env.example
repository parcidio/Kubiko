# ============================================
#  — .env EXAMPLE
# Valores de desenvolvimento — seguros de partilhar entre a equipa
# porque so existem na tua maquina/docker local, nao sao segredos reais.
# ============================================

# ---- Postgres ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ---- JWT ----
# Gera com: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MINUTES=
JWT_REFRESH_EXPIRATION_DAYS=

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Ombala API ----
OMBALA_TOKEN=
OMBALA_TOKEN=
OMBALA_OTP_EXPIRATION_MINUTES=

# ---- Multicaixa Express (fase futura) ----
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=
