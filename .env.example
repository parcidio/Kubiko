# ============================================
#  — .env EXAMPLE
# Valores de desenvolvimento — seguros de partilhar entre a equipa
# porque so existem na tua maquina/docker local, nao sao segredos reais.
# ============================================

# ---- Postgres ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# prefer em local · require no Neon
DB_SSLMODE=prefer
# Ligações no pool (o Neon fecha as inativas)
DB_POOL_SIZE=5

# ---- RabbitMQ ----
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Health check do RabbitMQ: false (não há broker no Render e nenhum código o usa ainda)
RABBITMQ_HEALTH_ENABLED=false

# ---- JWT ----
# Gera com: openssl rand -base64 64
# Obrigatório, ≥ 32 bytes — a API não arranca sem ele
JWT_SECRET=
# Por omissão 15 (curto de propósito; o refresh renova)
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vazio em local. Em produção: https://<api>/login/oauth2/code/google (atrás do proxy o pedido chega em HTTP)
GOOGLE_REDIRECT_URI=
# Para onde o login Google volta
FRONTEND_URL=http://localhost:3000

# ---- Ombala API ----
OMBALA_TOKEN=
OMBALA_SENDER=
OMBALA_OTP_EXPIRATION_MINUTES=

# ---- Pagamentos por referência (ver claude/decisoes-produto.md) ----
PAYMENTS_PROVIDER=simulated
PAYMENTS_SERVICE_FEE_RATE=0.08
PAYMENTS_REFERENCE_TTL=24h
PAYMENTS_SIMULATED_ENTITY=00000
# true só em dev/demo — nunca em produção
PAYMENTS_AUTO_CONFIRM=true

# ---- Multicaixa Express (fase futura) ----
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=

# ---- Storage privado: Backblaze B2, API S3 (documentos KYC) ----
# Bucket PRIVADO. Chave de aplicação com acesso só a este bucket. Obrigatório para a API arrancar.
B2_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_BUCKET=
APP_STORAGE_SIGNED_URL_TTL=5m

# ---- Notificações por email: Resend (ver claude/decisoes-produto.md) ----
# true só com domínio beeznoo.ao verificado no Resend (SPF/DKIM)
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM="Beeznoo <noreply@beeznoo.ao>"

# ---- Segurança (ver docs/SEGURANCA.md) ----
# Swagger: true só em desenvolvimento (desligado por omissão)
API_DOCS_ENABLED=false
# Cookie da sessão OAuth2 com Secure: true em staging/produção; false só em http://localhost
SESSION_COOKIE_SECURE=true
# Front noutro domínio (staging): origens do front separadas por vírgula, e o cookie do refresh com SameSite=None
CORS_ALLOWED_ORIGINS=
REFRESH_COOKIE_SAME_SITE=Strict
# Limites de pedidos: true sempre (false só para testes de carga)
RATE_LIMITS_ENABLED=true
# Nº de proxies à frente da API que acrescentam ao X-Forwarded-For: 0 em local; Vercel + Render = 2
RATE_LIMIT_TRUSTED_PROXIES=0
# 2FA por SMS no login de contas ADMIN: true sempre fora de desenvolvimento local
ADMIN_MFA_ENABLED=true
# memory (uma instância) | database (várias instâncias — contadores no Postgres)
RATE_LIMIT_STORE=memory
