# URL do backend Spring (usado pelo proxy do Next em next.config.ts)
# Local: http://localhost:8081 · Produção (Vercel): https://beeznoo.onrender.com
API_URL=
# Origem da API chamada pelo browser. Staging: https://beeznoo.onrender.com (a API precisa de CORS_ALLOWED_ORIGINS).
# Vazio = mesma origem: o Next faz proxy de /api/v1, /oauth2/authorization e /login/oauth2 (desenvolvimento local)
NEXT_PUBLIC_API_URL=
# WhatsApp da equipa Beeznoo (só dígitos, ex.: 244923000000) — botões "Falar no WhatsApp" e "Reportar problema"
NEXT_PUBLIC_WHATSAPP_NUMBER=
